<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>97f0f364-c2b2-4adf-b3a6-a9f12c0678fd</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>..\docker-compose\docker-compose.dcproj</DockerComposeProjectPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <Target Name="RecreatePostgres" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\.." Command="docker compose --project-name docker-compose -f docker-compose\docker-compose.yml -f docker-compose\docker-compose.override.yml down -v &amp;&amp; docker compose --project-name reference_data -f docker-compose\docker-compose.yml -f docker-compose\docker-compose.override.yml down -v &amp;&amp; docker compose --project-name reference_data -f docker-compose\docker-compose.yml -f docker-compose\docker-compose.override.yml up -d --wait postgres" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.2-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\db\db.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\db\sql-init\*.sql" Link="sql-init\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

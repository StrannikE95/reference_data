{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dictionary.integration.data",
  "type": "object",
  "additionalProperties": false,
  "required": ["loadId", "sourceCode", "sourceFile", "part", "last", "tables"],
  "properties": {
    "loadId": { "type": "string", "format": "uuid" },
    "sourceCode": {
      "enum": ["ass-building", "wall-material", "oktmo", "gar"]
    },
    "sourceFile": { "type": "string", "minLength": 1 },
    "part": { "type": "integer", "minimum": 1 },
    "last": { "type": "boolean" },
    "skippedLevel": { "type": "integer", "minimum": 0 },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "rows"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "rows": {
            "type": "array",
            "maxItems": 1000,
            "items": { "type": "object" }
          }
        }
      }
    }
  }
}
